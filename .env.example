# Copy to .env and fill in real values. .env is gitignored; this template is not.
# These are read by Kamal (ERB in config/deploy.yml + $VARs in .kamal/secrets)
# when you run bin/kamal build / deploy from your machine or CI.

# --- Deploy target -----------------------------------------------------------
# The server Kamal deploys to (read by ERB in config/deploy.yml).
DEVCINE_HOST=

# Public domain, injected into the container (used by the app / Caddy routing).
DEVCINE_DOMAIN=

# --- Docker registry (Docker Hub: oliveiraandre/devcine) ---------------------
KAMAL_REGISTRY_USERNAME=
# Use an access token, not your account password.
KAMAL_REGISTRY_PASSWORD=

# --- Rails -------------------------------------------------------------------
# Generated on the server side; provide it here so Kamal can inject it.
RAILS_MASTER_KEY=

# --- Databases (Solid primary/cache/queue/cable, url-based) -------------------
DATABASE_URL=
CACHE_DATABASE_URL=
QUEUE_DATABASE_URL=
CABLE_DATABASE_URL=
