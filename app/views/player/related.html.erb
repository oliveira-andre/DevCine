<%# Lazy related sidebar frame (US8). Inside a collection it lists the sequence
    IN ORDER (feature 007); otherwise same-kind, recent. %>
<%= turbo_frame_tag "related" do %>
  <h2 class="player__section-title"><%= @sequenced ? "Episodes" : "More like this" %></h2>
  <% if @related.any? %>
    <% @related.each do |video| %>
      <%# Break out of the #related frame — a full player visit, not a frame swap. %>
      <%= link_to player_path(video.slug, sequence_params), class: "related__item",
            data: { turbo_frame: "_top", turbo_stream: true } do %>
        <%= poster_image_tag video.thumbnail, nil, alt: video.title,
              class: "related__img", limit: [ 400, 240 ] %>
        <div class="related__title"><%= video.title %></div>
      <% end %>
    <% end %>
  <% else %>
    <p class="related__empty">No related videos yet.</p>
  <% end %>
<% end %>
