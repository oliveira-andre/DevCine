<% content_for :title, @video.title %>
<% content_for :page_styles do %>
  <%= stylesheet_link_tag "player", "subtitles", "vendor/pickr-nano", "data-turbo-track": "dynamic" %>
<% end %>

<main class="player">
  <div class="player__stage">
    <% if @video.embed? %>
      <%# Live embeds stay in-frame (out of scope for the persistent player). %>
      <%= render "player/live_embed" %>
    <% elsif @video.file.attached? %>
      <%# The <video> lives in the layout host; this reserves its expanded area
          and the player-source hands the descriptor to the persistent player. %>
      <div id="player-stage" data-slug="<%= @video.slug %>"></div>
      <div data-controller="player-source"
           data-player-source-slug-value="<%= @video.slug %>"
           <%# Explicitly redirect mode, NOT the proxy (rails_blob_path would
               still resolve to the proxy via resolve_model_to_route): the disk
               controller streams byte ranges of any size (Rack::Files), while
               the proxy 416s a range larger than streaming_chunk_max_size and
               buffers it in memory — a <video> asks for bytes=0- (the whole
               file), so multi-GB movies only play through the redirect path. %>
           data-player-source-src-value="<%= rails_storage_redirect_path(@video.file) %>"
           data-player-source-artwork-value="<%= @video.thumbnail.attached? ? url_for(@video.thumbnail) : "/logo.png" %>"
           data-player-source-title-value="<%= @video.title %>"
           data-player-source-album-value="<%= @album %>"
           data-player-source-prev-url-value="<%= @prev_video ? player_path(@prev_video.slug, sequence_params) : "" %>"
           data-player-source-next-url-value="<%= @next_video ? player_path(@next_video.slug, sequence_params) : "" %>"
           data-player-source-resume-value="<%= @resume_position.to_i %>"
           data-player-source-list-value="<%= sequence_params[:list] %>"
           data-player-source-views-url-value="<%= views_player_path(@video.slug) %>"
           data-player-source-progress-url-value="<%= progress_player_path(@video.slug) %>"
           data-player-source-up-next-url-value="<%= up_next_player_path(@video.slug, sequence_params) %>"
           data-player-source-subtitles-value="<%= subtitle_tracks_json(@video, @subtitle_tracks) %>"
           data-player-source-sub-enabled-value="<%= Current.user.subtitles_enabled %>"
           data-player-source-sub-text-color-value="<%= Current.user.subtitle_text_color %>"
           data-player-source-sub-bg-color-value="<%= Current.user.subtitle_background_color %>"
           data-player-source-sub-font-size-value="<%= Current.user.subtitle_font_size %>"
           data-player-source-sub-font-weight-value="<%= Current.user.subtitle_font_weight %>"
           hidden></div>
    <% else %>
      <div class="player__unavailable">This video is not available yet.</div>
    <% end %>
  </div>

  <%# Details revealed on scroll (not in fullscreen): left col + related sidebar. %>
  <section class="player__details">
    <div class="player__main">
      <div class="player__actions">
        <%= render "reactions/reactions", record: @video %>
        <%= render "player/autoplay_toggle" %>
        <% unless @video.embed? %>
          <%= render "player/subtitle_controls" %>
        <% end %>
        <div class="menu" data-controller="menu">
          <button type="button" class="reaction-btn menu__toggle"
                  data-action="menu#toggle" aria-label="More options"><%= icon(:dots) %></button>
          <div class="menu__list" data-menu-target="list" hidden>
            <button type="button" class="menu__item" data-controller="clipboard"
                    data-clipboard-text-value="<%= player_url(@video.slug) %>"
                    data-action="clipboard#copy">
              <%= icon(:share) %><span data-clipboard-target="label">Share</span>
            </button>
            <%= link_to add_to_playlist_player_path(@video.slug), class: "menu__item",
                  data: { turbo_frame: "modal" } do %>
              <%= icon(:plus) %><span>Add to playlist</span>
            <% end %>
          </div>
        </div>
      </div>

      <h1 class="player__title"><%= @video.title %></h1>

      <% if @video.description.present? %>
        <% if @video.description.length > 200 %>
          <div class="player__description read-more" data-controller="read-more">
            <div class="read-more__content"><%= simple_format(@video.description) %></div>
            <button type="button" class="read-more__trigger"
                    data-read-more-target="trigger" data-action="read-more#toggle">Read more</button>
          </div>
        <% else %>
          <div class="player__description"><%= simple_format(@video.description) %></div>
        <% end %>
      <% end %>

      <div class="player__comments">
        <h2 class="player__section-title">Comments</h2>
        <%= render "comments/form", video: @video, comment: Comment.new %>
        <%= turbo_frame_tag "comments_page_1", src: comments_player_path(@video.slug), loading: :lazy do %>
          <span class="player__loader"><%= icon(:spinner) %></span>
        <% end %>
      </div>
    </div>

    <aside class="player__sidebar">
      <%= turbo_frame_tag "related", src: related_player_path(@video.slug, sequence_params), loading: :lazy do %>
        <span class="player__loader"><%= icon(:spinner) %></span>
      <% end %>
    </aside>
  </section>
</main>
