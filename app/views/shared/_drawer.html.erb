<div class="drawer" data-drawer-target="root" data-action="keydown@window->drawer#keydown">
  <div class="drawer__backdrop" data-drawer-target="backdrop" data-action="click->drawer#close"></div>

  <nav class="drawer__panel" data-drawer-target="panel" role="dialog" aria-modal="true"
       aria-label="Main navigation">
    <button type="button" class="drawer__close" data-action="drawer#close" aria-label="Close menu">✕</button>

    <ul class="drawer__nav">
      <li><%= link_to root_path, class: "drawer__link", data: { turbo_stream: true, action: "drawer#close" } do %><%= icon(:home) %><span>Home</span><% end %></li>
      <li><%= link_to lives_path, class: "drawer__link", data: { turbo_stream: true, action: "drawer#close" } do %><%= icon(:live) %><span>Lives</span><% end %></li>
      <li><%= link_to videos_path, class: "drawer__link", data: { turbo_stream: true, action: "drawer#close" } do %><%= icon(:videos) %><span>Videos</span><% end %></li>
      <li><%= link_to movies_path, class: "drawer__link", data: { turbo_stream: true, action: "drawer#close" } do %><%= icon(:movie) %><span>Movies</span><% end %></li>
      <li><%= link_to series_index_path, class: "drawer__link", data: { turbo_stream: true, action: "drawer#close" } do %><%= icon(:serie) %><span>Series</span><% end %></li>
      <li><%= link_to playlists_path, class: "drawer__link", data: { turbo_stream: true, action: "drawer#close" } do %><%= icon(:playlist) %><span>Playlists</span><% end %></li>
      <li><%= link_to account_path, class: "drawer__link", data: { turbo_stream: true, action: "drawer#close" } do %><%= icon(:account) %><span>Account</span><% end %></li>
      <% if Current.user&.admin? %>
        <%# Full Drive visit (no turbo_stream): the admin chrome differs from the
            app's, so the whole body must re-render, not just #page-content. %>
        <li><%= link_to admin_dashboard_path, class: "drawer__link", data: { action: "drawer#close" } do %><%= icon(:dashboard) %><span>Dashboard</span><% end %></li>
      <% end %>
    </ul>

    <div class="drawer__footer">
      <%= button_to session_path, method: :delete, class: "drawer__link drawer__signout" do %>
        <%= icon(:sign_out) %><span>Sign out</span>
      <% end %>
    </div>
  </nav>
</div>
