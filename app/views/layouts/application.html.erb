<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "DevCine" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/logo.png" type="image/png">
    <link rel="icon" href="/logo.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/logo.png">


    <%# Shared design-token layer (order matters: tokens first). %>
    <%= stylesheet_link_tag "shared/variables", "shared/typography", "shared/reset",
                            "shared/focus", "shared/layout", "shared/buttons", "shared/forms",
                            "shared/header", "shared/icons", "shared/media", "shared/drawer",
                            "shared/modal", "shared/mini_player",
                            "data-turbo-track": "reload" %>
    <%# ALL page-scoped stylesheets, loaded up front: stream navigation swaps only
        #page-content and never re-renders <head>, so every page's (class-scoped)
        CSS must already be present. Files stay page-scoped per Constitution IV;
        only delivery is consolidated. %>
    <%= stylesheet_link_tag "account", "admin", "auth", "catalog_controls", "collection",
                            "home", "listing", "player", "search", "subtitles",
                            "vendor/pickr-nano",
                            "data-turbo-track": "dynamic" %>
    <%# Legacy per-view content_for(:page_styles) — harmless duplicates on full loads. %>
    <%= yield :page_styles %>
    <%= javascript_importmap_tags %>
  </head>

  <body id="body" class="<%= content_for(:body_class) %>" data-controller="drawer pin-lock back-navigation">
    <% if authenticated? %>
      <%= render "shared/header" %>
      <%= render "shared/drawer" %>
    <% end %>

    <%# Spotsby-style shell: in-app links navigate by streaming a new body into
        this div. The mini-player below is a SIBLING — navigation never touches
        it, so playback is uninterrupted by construction (Constitution V). %>
    <div id="page-content">
      <%= yield %>
    </div>

    <%# Toast notifications: a body-level sibling, floating over the page instead
        of sitting in the flow under the header. Auth pages render their flash
        inside the card, so this stays empty there. %>
    <div id="flash" class="flash-stack" role="status" aria-live="polite">
      <%= render "shared/flash" if authenticated? %>
    </div>

    <%# Persistent mini-player (feature 010). Stream navigation never touches this
        sibling. data-turbo-permanent remains as a SAFETY NET: any link that
        didn't opt into turbo_stream does a classic Drive visit, and permanent
        keeps the player alive through that too (with the resume-on-render patch). %>
    <% if authenticated? %>
      <%= render "shared/mini_player" %>
    <% end %>

    <%# Shared modal target — new/edit forms render into this frame (Constitution I). %>
    <%= turbo_frame_tag "modal" %>
  </body>
</html>
