<%# Two callers, told apart by whether Turbo is asking for the frame:
    - the upload form's lazy frame → radios that ride along with that form
    - the admin catalog redirect (a real page) → its own chrome and submits %>
<% if turbo_frame_request? %>
  <%= turbo_frame_tag "thumbnail_suggestions" do %>
    <%= render "thumbnail_suggestions/frame_grid", video: @video %>
  <% end %>
<% else %>
  <% content_for :title, "Choose a thumbnail" %>
  <% content_for :page_styles do %>
    <%= stylesheet_link_tag "admin", "data-turbo-track": "dynamic" %>
  <% end %>

  <main class="admin">
    <section class="admin__content">
      <header class="admin__head">
        <h1 class="admin__title">Choose a thumbnail</h1>
      </header>

      <div class="thumb-suggest">
        <% if @video.thumbnail_candidates.attached? %>
          <%= render "thumbnail_suggestions/chooser", video: @video, return_to: params[:return_to] %>
        <% else %>
          <p class="thumb-suggest__none">Couldn’t read any frames from this file.</p>
          <%= button_to "Continue", thumbnail_suggestions_video_path(@video, return_to: params[:return_to]),
                method: :delete, class: "btn btn-primary" %>
        <% end %>
      </div>
    </section>
  </main>
<% end %>
