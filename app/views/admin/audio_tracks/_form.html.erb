<%# Audio track form: name + language + an audio dropzone. A NEW track always
    needs a file; on edit the file is optional (drop one to replace) — and the
    embedded default track usually has none at all. %>
<%= form_with model: [ :admin, @video, @audio_track ], class: "modal__form" do |form| %>
  <% if @audio_track.errors.any? %>
    <div class="form-flash form-flash-alert"><%= @audio_track.errors.full_messages.first %></div>
  <% end %>

  <div class="field">
    <%= form.label :name, class: "field-label" %>
    <%= form.text_field :name, class: "field-input", placeholder: "English", required: true %>
  </div>

  <div class="field">
    <%= form.label :language, "Language code (optional)", class: "field-label" %>
    <%= form.text_field :language, class: "field-input", placeholder: "eng" %>
  </div>

  <% unless @audio_track.persisted? && @audio_track.default? && !@audio_track.file.attached? %>
    <div class="field">
      <%= form.label :file, "Audio file", class: "field-label" %>
      <div class="dropzone" data-controller="dropzone" data-dropzone-auto-submit-value="false"
           data-action="click->dropzone#browse dragover->dropzone#over dragleave->dropzone#leave drop->dropzone#drop">
        <%= form.file_field :file, accept: "audio/*,.m4a,.aac,.mp3", class: "dropzone__input",
              data: { "dropzone-target": "input", action: "change->dropzone#changed" } %>
        <span class="dropzone__icon"><%= icon(:upload) %></span>
        <span data-dropzone-target="label"><%=
          if @audio_track.persisted? && @audio_track.file.attached?
            "#{@audio_track.file.filename} — drop a new audio file to replace"
          else
            "Drag & drop the audio file (.m4a), or click to browse"
          end
        %></span>
        <button type="button" class="dropzone__clear" data-dropzone-target="clear"
                data-action="dropzone#clear" hidden aria-label="Clear picked file">
          <%= icon(:trash) %>
        </button>
      </div>
    </div>
  <% end %>

  <div class="modal__footer">
    <button type="button" class="btn btn-outline" data-action="modal#close">Cancel</button>
    <%= form.submit "Save", class: "btn btn-primary" %>
  </div>
<% end %>
