<%# Audio-track manager modal (MKV ingest): the video's named tracks (download
    per stripped file, edit, confirmed remove for alternates) plus the add
    form — same shape as the subtitle manager. The default track has no
    separate file: its sound is embedded in the playable MP4 itself. %>
<%= modal title: "Audio — #{@video.title}", size: :wide do %>
  <% if @audio_tracks.any? %>
    <div id="admin_audio_tracks" class="admin-lives">
      <%= render partial: "admin/audio_tracks/row", collection: @audio_tracks, as: :audio_track %>
    </div>
  <% else %>
    <p class="thumb-suggest__none">
      No audio tracks recorded yet — the ingest job hasn't processed this video
      (bin/rails videos:ingest backfills it). You can also add a track by hand below.
    </p>
  <% end %>

  <div class="mt-4">
    <%= render "admin/audio_tracks/form" %>
  </div>
<% end %>
