<%= modal title: "Edit video" do %>
  <%= form_with model: @video, url: admin_video_path(@video), method: :patch, class: "modal__form" do |form| %>
    <% if @video.errors.any? %>
      <div class="form-flash form-flash-alert"><%= @video.errors.full_messages.first %></div>
    <% end %>

    <div class="field">
      <%= form.label :title, class: "field-label" %>
      <%= form.text_field :title, required: true, class: "field-input" %>
    </div>

    <div class="field">
      <%= form.label :description, class: "field-label" %>
      <%= form.text_area :description, rows: 4, class: "field-input", data: { controller: "textarea-autogrow" } %>
    </div>

    <div class="field">
      <%= form.label :maturity_rating, "Maturity", class: "field-label" %>
      <%= form.select :maturity_rating, Video.maturity_ratings.keys.map { |k| [ k, k ] }, {}, class: "field-input" %>
    </div>

    <div class="field">
      <%= form.label :visibility, class: "field-label" %>
      <%= form.select :visibility,
            Video.visibilities.keys.map { |v| [ (v == "restricted" ? "Restricted (PIN) — A18" : v.titleize), v ] },
            {}, class: "field-input" %>
      <p class="field-hint">Restricted requires an A18 maturity rating.</p>
    </div>

    <div class="modal__footer">
      <button type="button" class="btn btn-outline" data-action="modal#close">Cancel</button>
      <%= form.submit "Save", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
