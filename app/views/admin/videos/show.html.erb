<% content_for :title, "#{@video.title} — Subtitles" %>
<% content_for :page_styles do %>
  <%= stylesheet_link_tag "admin", "data-turbo-track": "dynamic" %>
<% end %>

<main class="admin admin--shell">
  <%= render "admin/shared/sidebar" %>

  <section class="admin__content">
    <header class="admin__head">
      <h1 class="admin__title"><%= @video.title %> — Subtitles</h1>
      <div class="admin__toolbar">
        <%= link_to admin_videos_path, class: "btn btn-outline" do %>← Back<% end %>
        <%= link_to new_admin_video_subtitle_path(@video), class: "btn btn-primary admin__add",
              data: { turbo_frame: "modal" } do %>
          <%= icon(:plus) %><span>Add subtitle</span>
        <% end %>
      </div>
    </header>

    <div id="admin_subtitles" class="admin-lives">
      <% if @subtitles.any? %>
        <%= render partial: "admin/subtitles/row", collection: @subtitles, as: :subtitle %>
      <% else %>
        <p class="admin-lives__empty" id="admin_subtitles_empty">No subtitle tracks yet — tap Add subtitle.</p>
      <% end %>
    </div>
  </section>
</main>
