<% content_for :title, "Subtitles" %>
<% content_for :page_styles do %>
  <%= stylesheet_link_tag "admin", "data-turbo-track": "dynamic" %>
<% end %>

<main class="admin admin--shell">
  <%= render "admin/shared/sidebar" %>

  <section class="admin__content">
    <header class="admin__head">
      <h1 class="admin__title">Subtitles</h1>
    </header>

    <div class="admin__searchrow">
      <%= form_with url: admin_videos_path, method: :get, class: "admin-search",
            data: { controller: "search-submit", turbo_frame: "admin_videos", turbo_action: "advance" } do %>
        <span class="admin-search__icon"><%= icon(:search) %></span>
        <%= text_field_tag :q, @query, placeholder: "Search videos by title",
              class: "field-input admin-search__input", autocomplete: "off",
              data: { action: "input->search-submit#submit", "search-submit-target": "input" } %>
      <% end %>
    </div>

    <%= turbo_frame_tag "admin_videos", class: "admin-lives" do %>
      <%= render "admin/videos/list" %>
    <% end %>
  </section>
</main>
