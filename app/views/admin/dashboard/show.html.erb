<% content_for :title, "Admin dashboard" %>
<% content_for :page_styles do %>
  <%= stylesheet_link_tag "admin", "data-turbo-track": "dynamic" %>
<% end %>

<main class="admin">
  <section class="admin__content">
    <header class="admin__head">
      <%= icon(:dashboard, class: "admin__icon") %>
      <h1 class="admin__title">Admin dashboard</h1>
    </header>

    <section class="admin__stats">
      <div class="admin-stat">
        <span class="admin-stat__value"><%= @users_count %></span>
        <span class="admin-stat__label">Members</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat__value"><%= @videos_count %></span>
        <span class="admin-stat__label">Videos</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat__value"><%= @movies_count %></span>
        <span class="admin-stat__label">Movies</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat__value"><%= @playlists_count %></span>
        <span class="admin-stat__label">Playlists</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat__value"><%= @comments_count %></span>
        <span class="admin-stat__label">Comments</span>
      </div>
    </section>

    <%= render "admin/dashboard/table",
          key: "members", title: "Recent members",
          more_url: admin_users_path, more_label: "All users",
          headers: [ "Email", "Name", "Role", "Joined" ],
          empty: "No members yet.",
          rows: @recent_users.map { |u| [
            link_to(u.email_address, admin_user_path(u), class: "admin-user__link"),
            u.display_name.presence || "—",
            user_role_badge(u),
            l(u.created_at.to_date, format: :long)
          ] } %>

    <%= render "admin/dashboard/table",
          key: "videos", title: "Recent videos",
          more_url: admin_videos_path, more_label: "All videos",
          headers: [ "Title", "Kind", "Uploader", "Added" ],
          empty: "No public videos yet.",
          rows: @recent_videos.map { |v| [
            link_to(v.title, player_path(v.slug), class: "admin-user__link"),
            tag.span(v.kind.to_s.titleize, class: "admin-chip"),
            (v.uploader ? link_to(v.uploader.email_address, admin_user_path(v.uploader),
                                  class: "admin-user__link") : "—"),
            l(v.created_at.to_date, format: :long)
          ] } %>

    <%= render "admin/dashboard/table",
          key: "movies", title: "Recent movies",
          more_url: admin_catalog_index_path, more_label: "Catalog",
          headers: [ "Title", "Year", "Rating", "Added" ],
          empty: "No movies yet.",
          rows: @recent_movies.map { |m| [
            link_to(m.title, admin_catalog_item_path("movie", m), class: "admin-user__link"),
            m.release_date&.year || "—",
            tag.span(m.maturity_rating.to_s.upcase, class: "admin-chip"),
            l(m.created_at.to_date, format: :long)
          ] } %>

    <%= render "admin/dashboard/table",
          key: "playlists", title: "Recent playlists",
          more_url: admin_playlists_path, more_label: "All playlists",
          headers: [ "Title", "Owner", "Videos", "Visibility", "Created" ],
          empty: "No playlists yet.",
          rows: @recent_playlists.map { |p| [
            p.title,
            link_to(p.user.email_address, admin_user_path(p.user), class: "admin-user__link"),
            p.videos_count,
            tag.span(p.visibility.to_s.titleize, class: "admin-chip"),
            l(p.created_at.to_date, format: :long)
          ] } %>

    <%= render "admin/dashboard/table",
          key: "comments", title: "Recent comments",
          more_url: admin_comments_path, more_label: "All comments",
          headers: [ "Comment", "By", "On", "When" ],
          empty: "No comments yet.",
          rows: @recent_comments.map { |c| [
            link_to(truncate(c.body.to_s.squish, length: 60), admin_comment_path(c), class: "admin-user__link"),
            link_to(c.user.display_label, admin_user_path(c.user), class: "admin-user__link"),
            (admin_may_see?(c.video) ? c.video.title : "Hidden title"),
            l(c.created_at.to_date, format: :long)
          ] } %>
  </section>
</main>
