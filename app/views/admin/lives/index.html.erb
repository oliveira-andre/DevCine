<% content_for :title, "Lives" %>
<% content_for :page_styles do %>
  <%= stylesheet_link_tag "admin", "data-turbo-track": "dynamic" %>
<% end %>

<main class="admin admin--shell">
  <%= render "admin/shared/sidebar" %>

  <section class="admin__content">
    <header class="admin__head admin__head--lives">
      <h1 class="admin__title">Lives</h1>
      <div class="admin__toolbar">
        <%= form_with url: admin_lives_path, method: :get, class: "admin-search",
              data: { controller: "search-submit", turbo_frame: "admin_lives", turbo_action: "advance" } do %>
          <span class="admin-search__icon"><%= icon(:search) %></span>
          <%= text_field_tag :q, @query, placeholder: "Search lives by title",
                class: "field-input admin-search__input", autocomplete: "off",
                data: { action: "input->search-submit#submit", "search-submit-target": "input" } %>
        <% end %>
        <%= link_to new_admin_life_path, class: "btn btn-primary admin__add", data: { turbo_frame: "modal" } do %>
          <%= icon(:plus) %><span>Add</span>
        <% end %>
      </div>
    </header>

    <%= turbo_frame_tag "admin_lives", class: "admin-lives" do %>
      <%= render "admin/lives/list" %>
    <% end %>
  </section>
</main>
