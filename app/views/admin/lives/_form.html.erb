<%# Add/Edit live modal (feature 009). @live is a live-kind Video. %>
<%= modal title: (@live.persisted? ? "Edit live" : "Add live") do %>
  <%= form_with model: @live,
        url: (@live.persisted? ? admin_life_path(@live) : admin_lives_path),
        class: "modal__form" do |form| %>
    <% if @live.errors.any? %>
      <div class="form-flash form-flash-alert"><%= @live.errors.full_messages.first %></div>
    <% end %>

    <div class="field">
      <%= form.label :title, class: "field-label" %>
      <%= form.text_field :title, required: true, autofocus: true, class: "field-input" %>
    </div>

    <div class="field">
      <%= form.label :live_embed_url, "Embed link", class: "field-label" %>
      <%= form.url_field :live_embed_url, required: true, class: "field-input",
            placeholder: "https://www.youtube.com/embed/…" %>
    </div>

    <div class="modal__footer">
      <button type="button" class="btn btn-outline" data-action="modal#close">Cancel</button>
      <%= form.submit "Save", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
