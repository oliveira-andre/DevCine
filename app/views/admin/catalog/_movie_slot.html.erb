<%# The movie's single file slot — uploaded facts or the upload dropzone.
    Wrapped in a stable id so the upload flow can stream-replace it in place
    (no page reload). Locals: item. %>
<div class="admin-lives" id="admin_movie_slot_<%= item.id %>">
  <% if item.video.file.attached? %>
    <div class="admin-live">
      <span class="admin-live__title">
        <%= item.video.title %><span class="admin-badge">Uploaded</span>
      </span>
      <%= render "admin/catalog/slot_actions", video: item.video, type: "movie", item: item %>
    </div>
  <% else %>
    <div class="admin-live">
      <%= render "admin/catalog/video_upload", type: "movie", item: item,
            scope_field: :video_id, scope_value: item.video_id, big: true,
            label: "Drag & drop the movie file, or click to browse" %>
      <div class="admin-live__actions">
        <%= link_to new_admin_video_subtitle_path(item.video), class: "admin-live__action",
              data: { turbo_frame: "modal" }, "aria-label": "Add subtitles for #{item.title}" do %>
          <%= icon(:captions) %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
