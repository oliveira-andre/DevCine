<% content_for :title, "#{@item.title} — Catalog" %>
<% content_for :page_styles do %>
  <%= stylesheet_link_tag "admin", "data-turbo-track": "dynamic" %>
<% end %>

<main class="admin admin--shell">
  <%= render "admin/shared/sidebar" %>

  <section class="admin__content">
    <header class="admin__head">
      <h1 class="admin__title" id="admin_item_title"><%= @item.title %></h1>
      <div class="admin__toolbar">
        <%= link_to edit_admin_catalog_item_path(@item.is_a?(Movie) ? "movie" : "serie", @item),
              class: "btn btn-outline", data: { turbo_frame: "modal" },
              "aria-label": "Edit #{@item.title}" do %>
          <%= icon(:pencil) %> Edit
        <% end %>
        <%= link_to admin_catalog_index_path, class: "btn btn-outline" do %>← Catalog<% end %>
      </div>
    </header>

    <%= render "admin/catalog/summary", item: @item %>

    <% if @item.is_a?(Movie) %>
      <h2 class="admin__subtitle">Movie file</h2>
      <% if @item.video.file.attached? %>
        <div class="admin-lives">
          <div class="admin-live">
            <span class="admin-live__title">
              <%= @item.video.title %><span class="admin-badge">Uploaded</span>
            </span>
            <%= render "admin/catalog/slot_actions", video: @item.video, type: "movie", item: @item %>
          </div>
        </div>
      <% else %>
        <div class="admin-live">
          <%= form_with url: upload_admin_catalog_item_path("movie", @item), method: :post, multipart: true, class: "dropzone-form" do %>
            <%= hidden_field_tag :video_id, @item.video_id %>
            <div class="dropzone dropzone--big" data-controller="dropzone"
                 data-action="click->dropzone#browse dragover->dropzone#over dragleave->dropzone#leave drop->dropzone#drop">
              <%= file_field_tag :file, accept: "video/*", class: "dropzone__input",
                    data: { "dropzone-target": "input", action: "change->dropzone#changed" } %>
              <span class="dropzone__icon"><%= icon(:upload) %></span>
              <span data-dropzone-target="label">Drag &amp; drop the movie file, or click to browse</span>
            </div>
          <% end %>
          <div class="admin-live__actions">
            <%= link_to new_admin_video_subtitle_path(@item.video), class: "admin-live__action",
                  data: { turbo_frame: "modal" }, "aria-label": "Add subtitles for #{@item.title}" do %>
              <%= icon(:captions) %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <% @seasons.each do |season| %>
        <h2 class="admin__subtitle"><%= season.name %></h2>
        <div class="admin-lives">
          <% season.episodes.sort_by(&:position).each do |episode| %>
            <div class="admin-live">
              <span class="admin-live__title">
                E<%= episode.position %> — <%= episode.title %>
                <% if episode.video.file.attached? %><span class="admin-badge">Uploaded</span><% end %>
              </span>
              <% if episode.video.file.attached? %>
                <%= render "admin/catalog/slot_actions", video: episode.video, type: "serie", item: @item %>
              <% else %>
                <%= form_with url: upload_admin_catalog_item_path("serie", @item), method: :post, multipart: true, class: "dropzone-form" do %>
                  <%= hidden_field_tag :video_id, episode.video_id %>
                  <div class="dropzone" data-controller="dropzone"
                       data-action="click->dropzone#browse dragover->dropzone#over dragleave->dropzone#leave drop->dropzone#drop">
                    <%= file_field_tag :file, accept: "video/*", class: "dropzone__input",
                          data: { "dropzone-target": "input", action: "change->dropzone#changed" } %>
                    <span class="dropzone__icon"><%= icon(:upload) %></span>
                    <span data-dropzone-target="label">Drop the episode here, or click</span>
                  </div>
                <% end %>
                <div class="admin-live__actions">
                  <%= link_to new_admin_video_subtitle_path(episode.video), class: "admin-live__action",
                        data: { turbo_frame: "modal" }, "aria-label": "Add subtitles for #{episode.title}" do %>
                    <%= icon(:captions) %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <%# Add a brand-new episode (vanilla flow / extending an import). %>
          <div class="admin-live admin-catalog__addepisode">
            <%= form_with url: upload_admin_catalog_item_path("serie", @item), method: :post, multipart: true, class: "dropzone-form" do %>
              <%= hidden_field_tag :season_id, season.id %>
              <div class="admin-catalog__upload">
                <%= text_field_tag :title, nil, placeholder: "New episode title (optional)", class: "field-input" %>
                <div class="dropzone" data-controller="dropzone"
                     data-action="click->dropzone#browse dragover->dropzone#over dragleave->dropzone#leave drop->dropzone#drop">
                  <%= file_field_tag :file, accept: "video/*", class: "dropzone__input",
                        data: { "dropzone-target": "input", action: "change->dropzone#changed" } %>
                  <span class="dropzone__icon"><%= icon(:upload) %></span>
                  <span data-dropzone-target="label">Add episode: drop the video, or click</span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>
</main>
