<%= modal title: "Edit episode" do %>
  <%= form_with url: episode_admin_catalog_item_path("serie", @item, episode_id: @episode.id),
        method: :patch, class: "modal__form" do %>
    <% if @episode.errors.any? %>
      <div class="form-flash form-flash-alert"><%= @episode.errors.full_messages.first %></div>
    <% end %>

    <div class="field">
      <%= label_tag "episode[title]", "Title", class: "field-label" %>
      <%= text_field_tag "episode[title]", @episode.title, required: true, autofocus: true, class: "field-input" %>
    </div>

    <div class="field">
      <%= label_tag "episode[position]", "Position", class: "field-label" %>
      <%= number_field_tag "episode[position]", @episode.position, min: 1, class: "field-input" %>
    </div>

    <%# Episode thumbnail management — same section as the movie edit modal:
        current image + ✕ remove, or the JS-fetched frame chooser. Only for a
        slot that actually has a video file to analyse. %>
    <% if @episode.video.file.attached? %>
      <%= render "admin/catalog/edit_thumbnail", video: @episode.video, item: @item, type: "serie" %>
    <% end %>

    <div class="modal__footer">
      <button type="button" class="btn btn-outline" data-action="modal#close">Cancel</button>
      <%= submit_tag "Save", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
