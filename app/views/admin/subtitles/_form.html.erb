<%# Subtitle form (feature 012): language + default + an SRT dropzone (click or
    drag&drop; picked file shows its name with a clear button). %>
<%= form_with model: [ :admin, @video, @subtitle ], class: "modal__form" do |form| %>
  <% if @subtitle.errors.any? %>
    <div class="form-flash form-flash-alert"><%= @subtitle.errors.full_messages.first %></div>
  <% end %>

  <div class="field">
    <%= form.label :language, class: "field-label" %>
    <%= form.select :language,
          Subtitle.languages.keys.map { |lang| [ lang.titleize, lang ] },
          {}, class: "field-input" %>
  </div>

  <div class="field">
    <%= form.label :file, "SRT file", class: "field-label" %>
    <div class="dropzone" data-controller="dropzone" data-dropzone-auto-submit-value="false"
         data-action="click->dropzone#browse dragover->dropzone#over dragleave->dropzone#leave drop->dropzone#drop">
      <%= form.file_field :file, accept: ".srt", class: "dropzone__input",
            data: { "dropzone-target": "input", action: "change->dropzone#changed" } %>
      <span class="dropzone__icon"><%= icon(:upload) %></span>
      <span data-dropzone-target="label"><%=
        if @subtitle.persisted? && @subtitle.file.attached?
          "#{@subtitle.file.filename} — drop a new .srt to replace"
        else
          "Drag & drop the .srt file, or click to browse"
        end
      %></span>
      <button type="button" class="dropzone__clear" data-dropzone-target="clear"
              data-action="dropzone#clear" hidden aria-label="Clear picked file">
        <%= icon(:trash) %>
      </button>
    </div>
  </div>

  <div class="field">
    <label class="field-check">
      <%= form.check_box :is_default %> Default track
    </label>
  </div>

  <div class="modal__footer">
    <button type="button" class="btn btn-outline" data-action="modal#close">Cancel</button>
    <%= form.submit "Save", class: "btn btn-primary" %>
  </div>
<% end %>
