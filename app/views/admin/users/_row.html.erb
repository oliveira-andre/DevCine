<%# One user row: email (the search key) left, role + actions right. %>
<div id="admin_user_row_<%= item.id %>" class="admin-live">
  <span class="admin-live__title">
    <%= item.email_address %>
    <% if item.display_name.present? %>
      <span class="admin-user__aka"><%= item.display_name %></span>
    <% end %>
  </span>
  <div class="admin-live__actions">
    <%= user_role_badge(item) %>
    <%= link_to admin_user_path(item), class: "admin-live__action",
          "aria-label": "View #{item.email_address}" do %><%= icon(:eye) %><% end %>
    <%= link_to edit_admin_user_path(item), class: "admin-live__action",
          data: { turbo_frame: "modal" },
          "aria-label": "Edit #{item.email_address}" do %><%= icon(:pencil) %><% end %>
  </div>
</div>
