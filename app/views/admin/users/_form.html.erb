<%# Admin user edit modal. Covers what the member can change on their own
    account (avatar, cover, display name, password) plus the three things only
    an admin can: email, role, and setting a password without knowing the
    current one. %>
<%= modal title: "Edit user" do %>
  <%= form_with model: @user, url: admin_user_path(@user), method: :patch, class: "modal__form" do |form| %>
    <% if @user.errors.any? %>
      <div class="form-flash form-flash-alert"><%= @user.errors.full_messages.first %></div>
    <% end %>

    <div class="field">
      <%= form.label :display_name, "Display name", class: "field-label" %>
      <%= form.text_field :display_name, class: "field-input", autocomplete: "off" %>
    </div>

    <div class="field">
      <%= form.label :email_address, "Email", class: "field-label" %>
      <%= form.email_field :email_address, required: true, class: "field-input", autocomplete: "off" %>
    </div>

    <div class="field">
      <%= form.label :role, class: "field-label" %>
      <% if @user == Current.user %>
        <%= form.select :role, User.roles.keys.map { |r| [ r.titleize, r ] },
              {}, class: "field-input", disabled: true %>
        <p class="field-hint">You cannot change your own role.</p>
      <% else %>
        <%= form.select :role, User.roles.keys.map { |r| [ r.titleize, r ] }, {}, class: "field-input" %>
      <% end %>
    </div>

    <div class="field">
      <%= form.label :password, "New password", class: "field-label" %>
      <%= form.password_field :password, class: "field-input", autocomplete: "new-password" %>
      <p class="field-hint">Leave blank to keep the current password.</p>
    </div>

    <div class="field">
      <%= form.label :password_confirmation, "Confirm new password", class: "field-label" %>
      <%= form.password_field :password_confirmation, class: "field-input", autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= form.label :avatar, "Profile picture", class: "field-label" %>
      <div class="uploader uploader--image" data-controller="file-upload">
        <%= form.file_field :avatar, accept: "image/*", class: "uploader__input",
              data: { "file-upload-target": "input", action: "change->file-upload#change" } %>
        <%= image_tag("", class: "image-preview", alt: "Profile preview",
              data: { "file-upload-target": "preview" }) %>
        <div class="uploader__prompt">
          <%= icon(:image) %>
          <span>Choose a profile picture</span>
        </div>
      </div>
    </div>

    <div class="field">
      <%= form.label :cover, "Cover image", class: "field-label" %>
      <div class="uploader uploader--image" data-controller="file-upload">
        <%= form.file_field :cover, accept: "image/*", class: "uploader__input",
              data: { "file-upload-target": "input", action: "change->file-upload#change" } %>
        <%= image_tag("", class: "image-preview", alt: "Cover preview",
              data: { "file-upload-target": "preview" }) %>
        <div class="uploader__prompt">
          <%= icon(:image) %>
          <span>Choose a cover image</span>
        </div>
      </div>
    </div>

    <div class="modal__footer">
      <button type="button" class="btn btn-outline" data-action="modal#close">Cancel</button>
      <%= form.submit "Save", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
