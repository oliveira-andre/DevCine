<%# Admin navigation. One element for both layouts: a fixed left column on
    desktop, an off-canvas left drawer on mobile toggled from the header's menu
    button (reuses the body-level `drawer` controller). "Back to app" sits at
    the end and returns to the app with a full Drive visit so the app chrome
    comes back. %>
<div class="admin-nav" data-drawer-target="root" data-action="keydown@window->drawer#keydown">
  <div class="admin-nav__backdrop" data-drawer-target="backdrop" data-action="click->drawer#close"></div>

  <nav class="admin-nav__panel" data-drawer-target="panel" aria-label="Admin">
    <button type="button" class="admin-nav__close" data-action="drawer#close"
            aria-label="Close menu">✕</button>

    <div class="admin-nav__links">
      <%= admin_nav_link "Dashboard", :dashboard, admin_dashboard_path %>
      <%= admin_nav_link "Catalog", :movie, admin_catalog_index_path, match: "/admin/catalog" %>
      <%= admin_nav_link "Videos", :videos, admin_videos_path %>
      <%= admin_nav_link "Lives", :live, admin_lives_path %>
      <%= admin_nav_link "Genres", :serie, admin_genres_path %>
      <%= admin_nav_link "Playlists", :playlist, admin_playlists_path %>
      <%= admin_nav_link "Comments", :captions, admin_comments_path %>
      <%= admin_nav_link "Users", :account, admin_users_path %>
    </div>

    <div class="admin-nav__footer">
      <%= link_to root_path, class: "admin-nav__link admin-nav__back", data: { action: "drawer#close" } do %>
        <%= icon(:sign_out) %><span>Back to app</span>
      <% end %>
    </div>
  </nav>
</div>
