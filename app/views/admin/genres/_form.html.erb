<%= modal title: (@genre.persisted? ? "Edit genre" : "Add genre") do %>
  <%= form_with model: @genre, url: (@genre.persisted? ? admin_genre_path(@genre) : admin_genres_path),
        class: "modal__form" do |form| %>
    <% if @genre.errors.any? %>
      <div class="form-flash form-flash-alert"><%= @genre.errors.full_messages.first %></div>
    <% end %>

    <div class="field">
      <%= form.label :name, class: "field-label" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "field-input" %>
    </div>

    <div class="modal__footer">
      <button type="button" class="btn btn-outline" data-action="modal#close">Cancel</button>
      <%= form.submit "Save", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
