<%# Inline "Add a playlist" control (feature 008, US1). Toggles between a button
    and an inline name input (confirm/cancel) via the playlist-create Stimulus
    controller; the form POSTs to playlists#create with the current video slug so
    the created playlist comes back as an add/remove row. `open: true` (error
    re-render) starts showing the form. %>
<div id="playlist-add-create" class="playlist-add__create"
     data-controller="playlist-create"
     data-playlist-create-open-value="<%= local_assigns[:open] ? true : false %>">
  <button type="button" class="playlist-add__row playlist-add__add"
          data-playlist-create-target="button" data-action="playlist-create#open">
    <span>Add a playlist</span>
    <%= icon(:plus) %>
  </button>

  <%= form_with url: playlists_path(slug: video.slug), class: "playlist-add__create-form",
        data: { playlist_create_target: "form", action: "submit->playlist-create#submit" } do %>
    <% if local_assigns[:playlist]&.errors&.any? %>
      <p class="playlist-add__error"><%= playlist.errors.full_messages.first %></p>
    <% end %>
    <div class="playlist-add__create-fields">
      <input type="text" name="playlist[title]" placeholder="Playlist name" maxlength="100"
             autocomplete="off" class="field-input playlist-add__input"
             value="<%= local_assigns[:playlist]&.title %>"
             data-playlist-create-target="input">
      <button type="submit" class="playlist-add__icon-btn playlist-add__confirm" aria-label="Create playlist">
        <%= icon(:check) %>
      </button>
      <button type="button" class="playlist-add__icon-btn playlist-add__cancel" aria-label="Cancel"
              data-action="playlist-create#cancel">
        <%= icon(:close) %>
      </button>
    </div>
  <% end %>
</div>
